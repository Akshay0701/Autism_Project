<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/colorAccent"
    android:layout_height="match_parent"
    tools:context=".Parent.ParentRegister">
   <ScrollView
        android:layout_width="match_parent"
        android:id="@+id/scrollable"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_margin="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:text="Parent Register"
                android:textSize="26dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryblack"
                android:layout_marginLeft="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"></TextView>
            <ImageView
                android:layout_width="match_parent"
                android:src="@drawable/childlogo"
                android:layout_height="200dp"></ImageView>
            <EditText
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:hint="Name"
                android:textColorHint="@color/colorPrimaryblack"
                android:textColorHighlight="@color/colorPrimaryblack"
                android:textColor="@color/colorPrimaryDark"
                android:id="@+id/parent_register_name"
                android:layout_height="wrap_content"></EditText>

            <EditText
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:hint="Email"
                android:textColorHint="@color/colorPrimaryblack"
                android:textColorHighlight="@color/colorPrimaryblack"
                android:textColor="@color/colorPrimaryDark"
                android:id="@+id/parent_register_email"
                android:layout_height="wrap_content"></EditText>
            <EditText
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColorHint="@color/colorPrimaryblack"
                android:textColorHighlight="@color/colorPrimaryblack"
                android:textColor="@color/colorPrimaryDark"
                android:id="@+id/parent_register_password"
                android:layout_height="wrap_content"></EditText>
            <EditText
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:hint="Phone No"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:textColorHint="@color/colorPrimaryblack"
                android:textColorHighlight="@color/colorPrimaryblack"
                android:textColor="@color/colorPrimaryDark"
                android:id="@+id/parent_register_phoneno"
                android:layout_height="wrap_content"></EditText>
            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textColor="@color/colorAccent"
                android:id="@+id/parent_register_Btn"
                android:background="@color/colorPrimary">
            </Button>
            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already Registered"
                android:textColor="@color/colorAccent"
                android:id="@+id/parent_register_gotoLogin"
                android:background="@color/colorAccent"
                android:layout_marginBottom="0dp"/>
            <Button
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Admin Login"
                android:textColor="@color/colorPrimaryDark"
                android:id="@+id/gotoAdmin"
                android:background="@color/colorAccent"
                android:layout_marginBottom="50dp"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>