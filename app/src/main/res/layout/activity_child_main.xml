<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Child.ChildMain">

    <ScrollView
        android:layout_width="match_parent"
        android:background="@color/colorAccent"
        android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/requestBox"
        android:layout_margin="10dp"
        android:layout_height="wrap_content">
    <TextView
        android:text="Child Home"
        android:textSize="26dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryblack"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"></TextView>

    <androidx.cardview.widget.CardView
        app:cardCornerRadius="10dp"
        android:padding="10dp"
        app:cardBackgroundColor="@color/colorAccent"
        android:background="@color/colorAccent"
        android:layout_margin="10dp"
        android:elevation="20dp"
        app:cardElevation="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:background="@color/colorAccent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="match_parent"
                android:id="@+id/child_home_clickboardBtn"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:layout_height="270dp"
                android:src="@drawable/clickboardimg"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardCornerRadius="10dp"
            android:padding="10dp"
            app:cardBackgroundColor="@color/colorAccent"
            android:background="@color/colorAccent"
            android:layout_margin="10dp"
            android:elevation="20dp"
            app:cardElevation="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/colorAccent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="match_parent"
                    android:id="@+id/child_home_todoListBtn"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:layout_height="270dp"
                    android:src="@drawable/todolistimg"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
            app:cardCornerRadius="10dp"
            android:padding="10dp"
            app:cardBackgroundColor="@color/colorAccent"
            android:background="@color/colorAccent"
            android:layout_margin="10dp"
            android:elevation="20dp"
            app:cardElevation="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/colorAccent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="match_parent"
                    android:id="@+id/child_home_gamesBtn"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:layout_height="270dp"
                    android:src="@drawable/abcdicon"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <androidx.cardview.widget.CardView
            app:cardCornerRadius="10dp"
            android:padding="10dp"
            app:cardBackgroundColor="@color/colorAccent"
            android:background="@color/colorAccent"
            android:layout_margin="10dp"
            android:elevation="20dp"
            app:cardElevation="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/colorAccent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="match_parent"
                    android:id="@+id/child_home_yotubeCartoonBtn"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:layout_height="270dp"
                    android:src="@drawable/youtubevideoimg"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    </ScrollView>


</RelativeLayout>