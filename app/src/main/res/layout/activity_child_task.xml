<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent"
    tools:context=".Child.ChildTaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:textColor="#305F72"
            android:layout_marginLeft="7dp"
            android:gravity="center"
            android:text="Task Details"
            android:textSize="26dp"
            android:textStyle="bold"/>

        <ImageView
            android:layout_width="match_parent"
            android:id="@+id/child_task_image"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:layout_height="250dp"
            android:src="@drawable/childlogo"
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/c1"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:cardBackgroundColor="#FFE9F9"
            app:cardElevation="6dp"
            app:cardCornerRadius="12dp"
            android:layout_margin="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="15dp">

                <ImageView
                    android:id="@+id/i1"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/a_b_c_d"/>

                <TextView
                    android:id="@+id/child_task_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_toEndOf="@id/i1"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:letterSpacing="0.03"
                    android:text="Descriptions"
                    android:textAlignment="center"
                    android:textColor="#305F72"
                    android:textSize="22sp"
                    android:textStyle="bold" />


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/c2"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:cardBackgroundColor="#FFE9F9"
            app:cardElevation="6dp"
            app:cardCornerRadius="12dp"
            android:layout_margin="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="15dp">

                <ImageView
                    android:id="@+id/i2"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/timeicon" />

                <TextView
                    android:id="@+id/child_task_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_toEndOf="@id/i2"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:letterSpacing="0.03"
                    android:text="3.20 pm"
                    android:textAlignment="center"
                    android:textColor="#305F72"
                    android:textSize="22sp"
                    android:textStyle="bold" />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:textColor="#305F72"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Timer Started!"
            android:textSize="21dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/child_task_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="20 sec left"
            android:textAlignment="center"
            android:textColor="#07AA9B"
            android:textSize="35sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/backiconwhite"></ImageView>


</RelativeLayout>